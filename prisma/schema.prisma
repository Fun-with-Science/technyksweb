generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

enum PlanInterval {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  LEMON_SQUEEZY
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String?
  googleId      String?        @unique
  name          String
  avatarUrl     String?
  role          UserRole       @default(STUDENT)
  onboardingCompleted Boolean  @default(false)
  learnerGoal          String?
  experienceLevel      String?
  membershipPreference String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  enrollments   Enrollment[]
  subscriptions Subscription[]
  certificates  Certificate[]
  payments      Payment[]
  reviews       Review[]
}

model Course {
  id               String                   @id @default(uuid())
  slug             String                   @unique
  title            String
  subtitle         String
  description      String                   @db.Text
  thumbnail        String?
  promoVideoUrl    String?                  @db.Text
  price            Float
  isFree           Boolean                  @default(false)
  currency         String                   @default("INR")
  level            String                   @default("Intermediate")
  category         String                   @default("Web Development")
  isPublished      Boolean                  @default(false)
  isArchived       Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  modules          Module[]
  enrollments      Enrollment[]
  certificates     Certificate[]
  payments         Payment[]
  reviews          Review[]
  coupons          Coupon[]
  membershipAccess MembershipCourseAccess[]
}

model Module {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lessons   Lesson[]
}

model Lesson {
  id            String   @id @default(uuid())
  moduleId      String
  module        Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title         String
  description   String?  @db.Text
  videoAssetRef String?
  duration      Int      @default(0)
  order         Int
  isFreePreview Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Enrollment {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId            String
  course              Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progressPercent     Float    @default(0.0)
  lastWatchedLessonId String?
  // MySQL does not support Prisma scalar-list columns; keep lesson IDs as JSON.
  completedLessonIds  Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, courseId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId, createdAt])
}

model MembershipPlan {
  id               String                   @id @default(uuid())
  name             String
  slug             String                   @unique
  description      String?                  @db.Text
  price            Float
  currency         String                   @default("INR")
  interval         PlanInterval
  isFree           Boolean                  @default(false)
  isActive         Boolean                  @default(true)
  accessAllCourses Boolean                  @default(true)
  // MySQL does not support Prisma scalar-list columns; keep feature lines as JSON.
  features         Json
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  subscriptions    Subscription[]
  courseAccess     MembershipCourseAccess[]
}

model MembershipCourseAccess {
  planId    String
  courseId  String
  plan      MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@id([planId, courseId])
  @@index([courseId])
}

model Subscription {
  id                         String             @id @default(uuid())
  userId                     String
  user                       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                     String
  plan                       MembershipPlan     @relation(fields: [planId], references: [id])
  status                     SubscriptionStatus @default(ACTIVE)
  currentPeriodStart         DateTime
  currentPeriodEnd           DateTime
  razorpaySubscriptionId     String?
  lemonSqueezySubscriptionId String?
  cancelAtPeriodEnd          Boolean            @default(false)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
}

model Coupon {
  id              String    @id @default(uuid())
  code            String    @unique
  discountPercent Float?
  discountAmount  Float?
  currency        String    @default("INR")
  scope           String    @default("COURSE")
  courseId        String?
  course          Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  expiryDate      DateTime?
  usageLimit      Int?
  timesUsed       Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Certificate {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  certificateNumber String   @unique
  pdfUrl            String
  issuedAt          DateTime @default(now())

  @@unique([userId, courseId])
}

model Payment {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Float
  currency        String
  status          PaymentStatus   @default(PENDING)
  provider        PaymentProvider
  paymentIntentId String?         @unique
  subscriptionId  String?
  planId          String?
  courseId        String?
  couponCode      String?
  course          Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
